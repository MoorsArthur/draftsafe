{
  "manifest_version": 2,
  "name": "Draftsafe Bridge",
  "short_name": "Draftsafe Bridge",
  "version": "0.4.0",
  "description": "Read-only mail routes and approval requests for AI agents. No send, move or delete permission.",
  "author": "Arthur Moors",
  "browser_specific_settings": {
    "gecko": {
      "id": "draftsafe-bridge@draftsafe.dev",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "32": "bridge/icons/draftsafe.svg",
    "64": "bridge/icons/draftsafe.svg"
  },
  "background": {
    "page": "bridge/background.html",
    "persistent": true
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "messages.save",
    "compose.save"
  ],
  "experiment_apis": {
    "draftsafeBridge": {
      "schema": "bridge/api/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "draftsafeBridge"
          ]
        ],
        "script": "bridge/api/implementation.js"
      }
    }
  }
}
